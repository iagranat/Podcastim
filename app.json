{
  "expo": {
    "name": "Podcastim",
    "slug": "Podcastim",
    "scheme": "podcastim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:podcastim.org.il",
        "applinks:www.podcastim.org.il"
      ]
    },
    "android": {
      "package": "il.org.podcastim.kids",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "podcastim.org.il",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.podcastim.org.il",
              "pathPrefix": "/"
            },
            {
              "scheme": "http",
              "host": "podcastim.org.il",
              "pathPrefix": "/"
            },
            {
              "scheme": "http",
              "host": "www.podcastim.org.il",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-status-bar"
    ]
  }
}
